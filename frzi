.navbar-wrapper {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 40px);
  max-width: 1220px;
  z-index: 1000;
}

.navbar {
  min-height: 72px;
  padding: 0 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  background: rgba(8, 8, 8, 0.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border: 1px solid rgba(255, 193, 7, 0.2);
  border-radius: 18px;

  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.45),
    0 0 25px rgba(255, 193, 7, 0.04);
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 2px;

  text-decoration: none;
  font-size: 21px;
  font-weight: 900;
  letter-spacing: -0.8px;
  white-space: nowrap;
}

.logo-main {
  color: #ffffff;
}

.logo-accent {
  color: #ffc107;
}

.navbar-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  flex: 1;
}

.nav-link {
  position: relative;

  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 10px 12px;

  border: none;
  background: transparent;

  color: #d8d8d8;
  text-decoration: none;

  font-size: 14px;
  font-weight: 500;

  cursor: pointer;
  transition: color 0.25s ease;
}

.nav-link::after {
  content: "";

  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 4px;

  height: 2px;

  background: #ffc107;

  transform: scaleX(0);
  transform-origin: center;

  transition: transform 0.25s ease;
}

.nav-link:hover {
  color: #ffffff;
}

.nav-link:hover::after {
  transform: scaleX(1);
}

