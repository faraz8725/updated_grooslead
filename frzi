  border-color: #e53935;
}

/* Tablet */

@media (max-width: 900px) {
  .navbar {
    padding: 0 17px;
  }

  .navbar-links {
    gap: 0;
  }

  .nav-link {
    padding: 9px 8px;
    font-size: 13px;
  }

  .nav-link::after {
    left: 8px;
    right: 8px;
  }
}

/* Mobile */

@media (max-width: 720px) {
  .navbar-wrapper {
    top: 12px;
    width: calc(100% - 24px);
  }

  .navbar {
    min-height: 62px;
    border-radius: 15px;
  }

  .navbar-links {
    display: none;
  }

  .navbar-logo {
    font-size: 19px;
  }

  .login-button span {
    display: none;
  }

  .login-button {
    width: 40px;
    height: 40px;
    padding: 0;
    justify-content: center;
  }
}



